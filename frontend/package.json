{
  "name": "backtest-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && node scripts/licenses.cjs",
    "dev": "vite build --watch",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "generate": "../.venv/bin/python scripts/export-openapi.py && openapi-typescript src/generated/openapi.json -o src/generated/api.d.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "@xyflow/react": "12.11.6",
    "clsx": "2.1.1",
    "lossless-json": "4.3.1",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
